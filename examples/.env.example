# UltraSync credentials
# Copy this file to .env in the project root and replace with your real values

# Your 12-digit UltraSync serial number (from panel or UltraSync app)
ULTRASYNC_SID=000000000000

# Your UltraSync passcode
ULTRASYNC_PASSCODE=00000000

# Panel user number to authenticate as
ULTRASYNC_USER_NUMBER=1

# That user's PIN
ULTRASYNC_USER_PIN=0000

# Only needed if panel uses legacy "Security password" auth mode (rare)
# ULTRASYNC_SECURITY_PASSWORD=0000000000
